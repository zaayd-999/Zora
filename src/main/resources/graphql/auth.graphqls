extend type Query {
    me: User
}

type Mutation {
    register(input: RegisterInput!): ApiResponseAuth!
    login(input: LoginInput!): ApiResponseAuth!
    passwordRecovery(input: PasswordRecoveryInput!): ApiResponseBoolean!
    verifyResetCode(input: VerifyResetCodeInput!): ApiResponseBoolean!
    resetPassword(input: ResetPasswordInput!): ApiResponseAuth!
}

type User {
    id: ID!
    username: String!
    email: String!
    createdAt: String!
}

type AuthPayload {
    accessToken: String!
    refreshToken: String!
    user: User!
}

type ApiResponseInfo  {
    message: String!
    code: String!
}

type ApiResponseAuth {
    data: AuthPayload!
    extras: ApiResponseInfo!
}

type ApiResponseBoolean {
    data: Boolean!
    extras: ApiResponseInfo!
}

input RegisterInput {
    username: String!
    email: String!
    password: String!
}

input LoginInput {
    usernameOrEmail: String!
    password: String!
}

input PasswordRecoveryInput {
    usernameOrEmail: String!
}

input VerifyResetCodeInput {
    usernameOrEmail: String!
    code: String!
}

input ResetPasswordInput {
    usernameOrEmail: String!
    password: String!
}